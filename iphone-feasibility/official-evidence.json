  {
    "document": "audio-session",
    "title": "mixWithOthers",
    "abstract": [
      {
        "text": "An option that indicates whether audio from this session mixes with audio from active sessions in other audio apps.",
        "type": "text"
      }
    ],
    "sections": [
      {
        "declarations": [
          {
            "languages": [
              "swift"
            ],
            "platforms": [
              "iOS",
              "iPadOS",
              "Mac Catalyst",
              "tvOS",
              "visionOS",
              "watchOS"
            ],
            "tokens": [
              {
                "kind": "keyword",
                "text": "static"
              },
              {
                "kind": "text",
                "text": " "
              },
              {
                "kind": "keyword",
                "text": "var"
              },
              {
                "kind": "text",
                "text": " "
              },
              {
                "kind": "identifier",
                "text": "mixWithOthers"
              },
              {
                "kind": "text",
                "text": ": "
              },
              {
                "identifier": "doc://com.apple.avfaudio/documentation/AVFAudio/AVAudioSession",
                "kind": "typeIdentifier",
                "preciseIdentifier": "c:objc(cs)AVAudioSession",
                "text": "AVAudioSession"
              },
              {
                "kind": "text",
                "text": "."
              },
              {
                "identifier": "doc://com.apple.avfaudio/documentation/AVFAudio/AVAudioSession/CategoryOptions-swift.struct",
                "kind": "typeIdentifier",
                "preciseIdentifier": "c:@E@AVAudioSessionCategoryOptions",
                "text": "CategoryOptions"
              },
              {
                "kind": "text",
                "text": " { "
              },
              {
                "kind": "keyword",
                "text": "get"
              },
              {
                "kind": "text",
                "text": " }"
              }
            ]
          }
        ],
        "kind": "declarations"
      },
      {
        "content": [
          {
            "anchor": "Discussion",
            "level": 2,
            "text": "Discussion",
            "type": "heading"
          },
          {
            "inlineContent": [
              {
                "text": "You can set this option explicitly only if the audio session category is ",
                "type": "text"
              },
              {
                "identifier": "doc://com.apple.avfaudio/documentation/AVFAudio/AVAudioSession/Category-swift.struct/playAndRecord",
                "isActive": true,
                "type": "reference"
              },
              {
                "text": ", ",
                "type": "text"
              },
              {
                "identifier": "doc://com.apple.avfaudio/documentation/AVFAudio/AVAudioSession/Category-swift.struct/playback",
                "isActive": true,
                "type": "reference"
              },
              {
                "text": ", or ",
                "type": "text"
              },
              {
                "identifier": "doc://com.apple.avfaudio/documentation/AVFAudio/AVAudioSession/Category-swift.struct/multiRoute",
                "isActive": true,
                "type": "reference"
              },
              {
                "text": ". If you set the audio session category to ",
                "type": "text"
              },
              {
                "identifier": "doc://com.apple.avfaudio/documentation/AVFAudio/AVAudioSession/Category-swift.struct/ambient",
                "isActive": true,
                "type": "reference"
              },
              {
                "text": ", the session automatically sets this option. Likewise, setting the ",
                "type": "text"
              },
              {
                "identifier": "doc://com.apple.avfaudio/documentation/AVFAudio/AVAudioSession/CategoryOptions-swift.struct/duckOthers",
                "isActive": true,
                "type": "reference"
              },
              {
                "text": " or ",
                "type": "text"
              },
              {
                "identifier": "doc://com.apple.avfaudio/documentation/AVFAudio/AVAudioSession/CategoryOptions-swift.struct/interruptSpokenAudioAndMixWithOthers",
                "isActive": true,
                "type": "reference"
              },
              {
                "text": " options also enables this option.",
                "type": "text"
              }
            ],
            "type": "paragraph"
          },
          {
            "inlineContent": [
              {
                "text": "Clearing this option and then activating your session interrupts other audio sessions. If you set this option, your app mixes its audio with audio playing in background apps, such as the Music app.",
                "type": "text"
              }
            ],
            "type": "paragraph"
          }
        ],
        "kind": "content"
      }
    ]
  },
