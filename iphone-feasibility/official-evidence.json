  {
    "document": "broadcast-handler",
    "title": "RPBroadcastSampleHandler",
    "abstract": [
      {
        "text": "An object that processes buffer objects as received from ReplayKit.",
        "type": "text"
      }
    ],
    "sections": [
      {
        "declarations": [
          {
            "languages": [
              "swift"
            ],
            "platforms": [
              "iOS",
              "iPadOS",
              "Mac Catalyst",
              "macOS",
              "tvOS",
              "visionOS"
            ],
            "tokens": [
              {
                "kind": "keyword",
                "text": "class"
              },
              {
                "kind": "text",
                "text": " "
              },
              {
                "kind": "identifier",
                "text": "RPBroadcastSampleHandler"
              }
            ]
          }
        ],
        "kind": "declarations"
      },
      {
        "content": [
          {
            "anchor": "overview",
            "level": 2,
            "text": "Overview",
            "type": "heading"
          },
          {
            "inlineContent": [
              {
                "text": "To handle ",
                "type": "text"
              },
              {
                "identifier": "doc://com.apple.documentation/documentation/CoreMedia/CMSampleBuffer",
                "isActive": true,
                "type": "reference"
              },
              {
                "text": " objects as captured by ReplayKit, you subclass ",
                "type": "text"
              },
              {
                "code": "RPBroadcastSampleHandler",
                "type": "codeVoice"
              },
              {
                "text": ". You enable this mode of handling by setting ",
                "type": "text"
              },
              {
                "code": "RPBroadcastProcessMode",
                "type": "codeVoice"
              },
              {
                "text": " in the extension’s ",
                "type": "text"
              },
              {
                "code": "Info.plist",
                "type": "codeVoice"
              },
              {
                "text": " file to ",
                "type": "text"
              },
              {
                "code": "RPBroadcastProcessModeSampleBuffer",
                "type": "codeVoice"
              },
              {
                "text": ".",
                "type": "text"
              }
            ],
            "type": "paragraph"
          },
          {
            "inlineContent": [
              {
                "text": "In your subclass, implement the ",
                "type": "text"
              },
              {
                "identifier": "doc://com.apple.replaykit/documentation/ReplayKit/RPBroadcastSampleHandler/processSampleBuffer(_:with:)",
                "isActive": true,
                "type": "reference"
              },
              {
                "text": " method to handle video and audio buffers, as well as the ",
                "type": "text"
              },
              {
                "identifier": "doc://com.apple.replaykit/documentation/ReplayKit/RPBroadcastSampleHandler/broadcastStarted(withSetupInfo:)",
                "isActive": true,
                "type": "reference"
              },
              {
                "text": ", ",
                "type": "text"
              },
              {
                "identifier": "doc://com.apple.replaykit/documentation/ReplayKit/RPBroadcastSampleHandler/broadcastFinished()",
                "isActive": true,
                "type": "reference"
              },
              {
                "text": ", ",
                "type": "text"
              },
              {
                "identifier": "doc://com.apple.replaykit/documentation/ReplayKit/RPBroadcastSampleHandler/broadcastPaused()",
                "isActive": true,
                "type": "reference"
              },
              {
                "text": ", and ",
                "type": "text"
              },
              {
                "identifier": "doc://com.apple.replaykit/documentation/ReplayKit/RPBroadcastSampleHandler/broadcastResumed()",
                "isActive": true,
                "type": "reference"
              },
              {
                "text": " methods to handle starting and stopping the broadcast.",
                "type": "text"
              }
            ],
            "type": "paragraph"
          },
          {
            "inlineContent": [
              {
                "text": "ReplayKit invokes methods in your ",
                "type": "text"
              },
              {
                "code": "RPBroadcastSampleHandler",
                "type": "codeVoice"
              },
              {
                "text": " subclass in a serial fashion. After invoking one method, ReplayKit won’t invoke another method until the first method returns. That means it’s safe for your implementations to update their stored state without the use of locks or synchronization to provide thread safety.",
                "type": "text"
              }
            ],
            "type": "paragraph"
          }
        ],
        "kind": "content"
      }
    ]
  },
  {
    "document": "broadcast-picker",
    "title": "RPSystemBroadcastPickerView",
    "abstract": [
      {
        "text": "A view displaying a broadcast button that, when tapped, shows a broadcast picker.",
        "type": "text"
      }
    ],
    "sections": [
      {
        "declarations": [
          {
            "languages": [
              "swift"
            ],
            "platforms": [
              "iOS",
              "iPadOS",
              "Mac Catalyst",
              "visionOS"
            ],
            "tokens": [
              {
                "kind": "keyword",
                "text": "class"
              },
              {
                "kind": "text",
                "text": " "
              },
              {
                "kind": "identifier",
                "text": "RPSystemBroadcastPickerView"
              }
            ]
          }
        ],
        "kind": "declarations"
      },
      {
        "content": [
          {
            "anchor": "overview",
            "level": 2,
            "text": "Overview",
            "type": "heading"
          },
          {
            "inlineContent": [
              {
                "text": "Add this view to your view hierarchy to let users broadcast directly from your app. When a user taps the broadcast button, it displays a broadcast picker, allowing the user to select a broadcast provider.",
                "type": "text"
              }
            ],
            "type": "paragraph"
          },
          {
            "content": [
              {
                "inlineContent": [
                  {
                    "text": "",
                    "type": "text"
                  },
                  {
                    "text": " ",
                    "type": "text"
                  },
                  {
                    "text": "Clicking the broadcast button has no effect in Mac apps built with Mac Catalyst.",
                    "type": "text"
                  }
                ],
                "type": "paragraph"
              }
            ],
            "name": "Note",
            "style": "note",
            "type": "aside"
          },
          {
            "inlineContent": [
              {
                "text": "You can limit the picker to a particular broadcast provider by setting ",
                "type": "text"
              },
              {
                "identifier": "doc://com.apple.replaykit/documentation/ReplayKit/RPSystemBroadcastPickerView/preferredExtension",
                "isActive": true,
                "type": "reference"
              },
              {
                "text": " to the bundle identifier of a broadcast extension. You can also show or hide the microphone button displayed in the picker by setting the ",
                "type": "text"
              },
              {
                "identifier": "doc://com.apple.replaykit/documentation/ReplayKit/RPSystemBroadcastPickerView/showsMicrophoneButton",
                "isActive": true,
                "type": "reference"
              },
              {
                "text": " property. Set these properties before presenting ",
                "type": "text"
              },
              {
                "identifier": "doc://com.apple.replaykit/documentation/ReplayKit/RPSystemBroadcastPickerView",
                "isActive": true,
                "type": "reference"
              },
              {
                "text": ", as shown here:",
                "type": "text"
              }
            ],
            "type": "paragraph"
          },
          {
            "code": [
              "class ViewController: UIViewController {",
              "",
              "    @IBOutlet var containerView: UIView!",
              "    ",
              "    override func viewDidLoad() {",
              "        super.viewDidLoad()",
              "     ",
              "        let broadcastPicker = RPSystemBroadcastPickerView(frame: CGRect(x: 0, y: 0, width: 50, height: 50))",
              "        broadcastPicker.preferredExtension = \"com.your-app.broadcast.extension\"",
              "",
              "        containerView.addSubview(broadcastPicker)",
              "    }",
              "    ",
              "}",
              ""
            ],
            "syntax": "swift",
            "type": "codeListing"
          }
        ],
        "kind": "content"
      }
    ]
  },
  {
    "document": "sample-buffer",
    "title": "processSampleBuffer(_:with:)",
    "abstract": [
      {
        "text": "Processes video and audio data as it becomes available during a live broadcast.",
        "type": "text"
      }
    ],
    "sections": [
      {
        "declarations": [
          {
            "languages": [
              "swift"
            ],
            "platforms": [
              "iOS",
              "iPadOS",
              "Mac Catalyst",
              "macOS",
              "tvOS",
              "visionOS"
            ],
            "tokens": [
              {
                "kind": "keyword",
                "text": "func"
              },
              {
                "kind": "text",
                "text": " "
              },
              {
                "kind": "identifier",
                "text": "processSampleBuffer"
              },
              {
                "kind": "text",
                "text": "("
              },
              {
                "kind": "externalParam",
                "text": "_"
              },
              {
                "kind": "text",
                "text": " "
              },
              {
                "kind": "internalParam",
                "text": "sampleBuffer"
              },
              {
                "kind": "text",
                "text": ": "
              },
              {
                "identifier": "doc://com.apple.documentation/documentation/CoreMedia/CMSampleBuffer",
                "kind": "typeIdentifier",
                "preciseIdentifier": "c:@T@CMSampleBufferRef",
                "text": "CMSampleBuffer"
              },
              {
                "kind": "text",
                "text": ", "
              },
              {
                "kind": "externalParam",
                "text": "with"
              },
              {
                "kind": "text",
                "text": " "
              },
              {
                "kind": "internalParam",
                "text": "sampleBufferType"
              },
              {
                "kind": "text",
                "text": ": "
              },
              {
                "identifier": "doc://com.apple.replaykit/documentation/ReplayKit/RPSampleBufferType",
                "kind": "typeIdentifier",
                "preciseIdentifier": "c:@E@RPSampleBufferType",
                "text": "RPSampleBufferType"
              },
              {
                "kind": "text",
                "text": ")"
              }
            ]
          }
        ],
        "kind": "declarations"
      },
      {
        "kind": "parameters",
        "parameters": [
          {
            "content": [
              {
                "inlineContent": [
                  {
                    "text": "A ",
                    "type": "text"
                  },
                  {
                    "identifier": "doc://com.apple.documentation/documentation/CoreMedia/CMSampleBuffer",
                    "isActive": true,
                    "type": "reference"
                  },
                  {
                    "text": " object containing either audio or video data.",
                    "type": "text"
                  }
                ],
                "type": "paragraph"
              }
            ],
            "name": "sampleBuffer"
          },
          {
            "content": [
              {
                "inlineContent": [
                  {
                    "text": "An ",
                    "type": "text"
                  },
                  {
                    "identifier": "doc://com.apple.replaykit/documentation/ReplayKit/RPSampleBufferType",
                    "isActive": true,
                    "type": "reference"
                  },
                  {
                    "text": " identifying the media type of the recorded sample.",
                    "type": "text"
                  }
                ],
                "type": "paragraph"
              }
            ],
            "name": "sampleBufferType"
          }
        ]
      },
      {
        "content": [
          {
            "anchor": "Discussion",
            "level": 2,
            "text": "Discussion",
            "type": "heading"
          },
          {
            "inlineContent": [
              {
                "text": "This method handles buffers of all sample buffer types throughout each broadcast. If no audio is available — for example, if the microphone isn’t capturing input — ReplayKit provides audio buffers whose samples represent continuous silence.",
                "type": "text"
              }
            ],
            "type": "paragraph"
          },
          {
            "inlineContent": [
              {
                "text": "ReplayKit provides sample buffers sequentially. After invoking this method with a sample buffer, ReplayKit won’t invoke the method again for any sample buffer type until the current invocation returns.",
                "type": "text"
              }
            ],
            "type": "paragraph"
          },
          {
            "inlineContent": [
              {
                "text": "The sample buffer passed to this method is available only until the method returns. You shouldn’t keep a reference to the sample buffer after the method returns.",
                "type": "text"
              }
            ],
            "type": "paragraph"
          }
        ],
        "kind": "content"
      }
    ]
  },
